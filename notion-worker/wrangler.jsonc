{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keats-home-notion",
  "main": "src/mcp-worker.js",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "observability": { "enabled": true },
  "vars": {
    "FRONTEND_ORIGIN": "https://gulugulu-lucky.github.io"
  },
  "d1_databases": [
    {
      "binding": "HOME_EVENTS_DB",
      "database_name": "keats-home-events",
      "database_id": "e26b6b97-e54e-4f2d-b225-dc09f6e9cb00",
      "migrations_dir": "migrations"
    }
  ]

  // OAuth requires one Cloudflare KV namespace. After creating it, add:
  // "kv_namespaces": [
  //   {
  //     "binding": "OAUTH_KV",
  //     "id": "<cloudflare-generated-kv-namespace-id>"
  //   }
  // ]
}
